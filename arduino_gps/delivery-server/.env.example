# คัดลอกเป็น .env แล้วแก้ค่า
PORT=3019

# token สำหรับ /api/admin/* (สุ่มยาว ๆ เช่น: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ADMIN_TOKEN=change-me-to-a-long-random-string

# URL ที่กล่อง ESP32 มองเห็น (ใช้สร้างลิงก์ดาวน์โหลด firmware) เช่น https://delivery.example.com
PUBLIC_BASE_URL=http://localhost:3019

# ถ้าจะให้ Node เปิด HTTPS เอง ให้ใส่ path ของ cert/key (หรือปล่อยว่างแล้วใช้ nginx/caddy ทำ TLS ข้างหน้า)
TLS_CERT_FILE=
TLS_KEY_FILE=

# public key สำหรับตรวจลายเซ็น firmware (สร้างด้วย npm run keygen)
FIRMWARE_PUBLIC_KEY_FILE=keys/firmware-signing-public.pem
# true = ยอมรับ firmware ไม่มีลายเซ็นเมื่อไม่มี public key (ทดสอบเท่านั้น ห้ามใช้ production)
ALLOW_UNSIGNED_FIRMWARE=false
MAX_FIRMWARE_BYTES=4194304

# secret สำหรับเซ็นลิงก์ดาวน์โหลด firmware (ว่าง = สุ่มใหม่ทุกครั้งที่ start)
DOWNLOAD_URL_SECRET=
DOWNLOAD_URL_TTL_SEC=600

# host ที่อนุญาตให้ตั้งเป็น data_server.host (คั่นด้วย , ว่าง = ไม่จำกัด · ใช้กับชื่อโดเมนเท่านั้น IPv4 ใส่ได้เสมอ)
DATA_SERVER_HOST_ALLOWLIST=data.example.com,192.168.1.100

DATA_DIR=data

# ความยาวขั้นต่ำของ device token (ทุกกล่องใช้รหัสร่วม 1234 จึงตั้งเป็น 4)
MIN_DEVICE_TOKEN_LENGTH=4

# หน้า /admin เรียก Gateway ผ่าน delivery-server
GATEWAY_ADMIN_URL=http://localhost:3018
GATEWAY_ADMIN_TOKEN=same-as-ADMIN_TOKEN-in-ws-gateway/.env
# โฟลเดอร์ firmware ที่ build ไว้ (ปุ่มนำเข้าในหน้า /admin)
FIRMWARE_DIST_DIR=../firmware/dist

# ลงทะเบียนกล่องอัตโนมัติ: กล่องที่ใช้รหัสนี้และยังไม่มีในระบบ จะถูกเพิ่มให้เอง (ว่าง = ปิด)
AUTO_REGISTER_TOKEN=1234

# เข้าหน้า http://localhost:3019/admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ระบบอื่นอัปโหลด firmware ที่ไม่มีลายเซ็นได้ -> server เซ็นให้ด้วย private key (ใครมี ADMIN_TOKEN ก็อัปโหลด firmware ที่กล่องยอมรับได้)
SIGN_ON_UPLOAD=true
FIRMWARE_PRIVATE_KEY_FILE=keys/firmware-signing-private.pem

# อนุญาตย้อนเป็น firmware เวอร์ชันเก่า (false = ต้องส่ง header X-Allow-Downgrade: true ทุกครั้ง)
ALLOW_FIRMWARE_DOWNGRADE=true
