# คัดลอกเป็น .env แล้วแก้ค่า
PORT=3018

# token สำหรับ /api/admin/* (สุ่มยาว ๆ เช่น: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ADMIN_TOKEN=change-me-to-a-long-random-string

# ถ้าจะให้ Node เปิด WSS/HTTPS เอง ให้ใส่ path ของ cert/key (หรือปล่อยว่างแล้วใช้ nginx/caddy ทำ TLS ข้างหน้า)
TLS_CERT_FILE=
TLS_KEY_FILE=

# รอบ ping/heartbeat (วินาที) — ส่งให้กล่องใน WELCOME ด้วย
HEARTBEAT_INTERVAL_SEC=10
# อายุคำสั่งค่าเริ่มต้น (วินาที) ถ้ายังไม่เริ่มทำจะเป็น EXPIRED
COMMAND_TTL_SEC=86400
MAX_MESSAGE_BYTES=16384

DATA_DIR=data

# ความยาวขั้นต่ำของ device token (ทุกกล่องใช้รหัสร่วม 1234 จึงตั้งเป็น 4)
MIN_DEVICE_TOKEN_LENGTH=4

# ลงทะเบียนกล่องอัตโนมัติ: กล่องที่ใช้รหัสนี้และยังไม่มีในระบบ จะถูกเพิ่มให้เอง (ว่าง = ปิด)
AUTO_REGISTER_TOKEN=1234

# แจ้งล้มเหลวเมื่อคำสั่งไปไม่ถึงกล่อง / กล่องไม่ตอบ (วินาที, 0 = ไม่จำกัด)
COMMAND_DELIVERY_TIMEOUT_SEC=600
COMMAND_RESPONSE_TIMEOUT_SEC=180
COMMAND_REBOOT_TIMEOUT_SEC=300
# กล่องหลุดการเชื่อมต่อระหว่างทำคำสั่ง (DELIVERED..VALIDATING) แล้วไม่กลับมา+HELLO ภายในเวลานี้ -> FAILED (DEVICE_DISCONNECTED)
# ไม่ใช้กับ INSTALLING/REBOOTING (ใช้ COMMAND_REBOOT_TIMEOUT_SEC) และ PENDING (ใช้ COMMAND_DELIVERY_TIMEOUT_SEC) (0 = ปิด)
COMMAND_DISCONNECT_GRACE_SEC=60
# รอกล่องพร้อมก่อนส่งงาน firmware ใหม่ นับจากกล่องต่อ Gateway หรืองานก่อนหน้าจบ (0 = ไม่รอ)
FIRMWARE_SETTLE_SEC=30

# แจ้งผลคำสั่งที่จบแล้ว (สำเร็จ/ล้มเหลว) ไปยังระบบอื่นแบบ POST JSON (ว่าง = ปิด)
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_TOKEN=
