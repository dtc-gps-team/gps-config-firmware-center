# ============================================
# Docker Compose infra (postgres / redis / minio)
# ============================================
POSTGRES_USER=gps_user
POSTGRES_PASSWORD=gps_password
POSTGRES_DB=gps_config_firmware
# host port 5432 มักชนกับ Postgres ตัวอื่นในเครื่อง — ใช้ 5433 เป็นค่าเริ่มต้นของโปรเจกต์นี้
POSTGRES_PORT=5433

REDIS_PORT=6379

MINIO_ROOT_USER=gps_minio_admin
MINIO_ROOT_PASSWORD=gps_minio_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ============================================
# Backend (NestJS) — ดู docs/planning/01_GPS_Build_Reference.md Section 7
# ============================================
DATABASE_URL=postgresql://gps_user:gps_password@localhost:5433/gps_config_firmware
REDIS_URL=redis://localhost:6379

# Integration tests (npm run test:integration) — ต้องเป็น database คนละตัวกับ dev
# ชื่อ database ต้องลงท้าย _test (setup.ts บล็อกถ้าไม่ใช่ กัน deleteMany ลบ dev data)
# สร้างครั้งแรก: docker exec gps-postgres createdb -U gps_user gps_config_firmware_test
#              แล้ว DATABASE_URL=<url ด้านล่าง> npx prisma migrate deploy
DATABASE_URL_TEST=postgresql://gps_user:gps_password@localhost:5433/gps_config_firmware_test

# Auth
# ใช้เซ็นและตรวจ token หลัง login ใครรู้ค่านี้ปลอม token เป็น Admin ได้ จึงต้องเป็นค่าสุ่มของ
# แต่ละเครื่อง ห้าม commit และห้ามส่งในแชท สร้างด้วย:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# ค่าด้านล่างเป็นแค่ตัวอย่าง พัฒนาในเครื่องใช้ได้ แต่ถ้า NODE_ENV=production หรือตั้ง TRUST_PROXY
# (เปิด tunnel / deploy) backend จะไม่ยอมเริ่มจนกว่าจะเปลี่ยนเป็นค่าสุ่มยาวอย่างน้อย 32 ตัวอักษร
# (ดู backend/src/common/jwt-secret.ts)
JWT_SECRET=changeme-generate-a-real-secret

# บัญชีทดสอบ (*.test) และ SuperAdmin คนแรก (backend/src/common/test-users.ts, initial-admin.ts)
# ตอนพัฒนาในเครื่อง seed สร้างบัญชีทดสอบทุกบทบาทรหัส password123 เหมือนเดิม ไม่ต้องตั้งอะไร
# ถ้าเปิดสู่ภายนอก (NODE_ENV=production หรือตั้ง TRUST_PROXY):
#   - seed ไม่สร้างบัญชีทดสอบและข้อมูลตัวอย่าง เว้นแต่ SEED_TEST_USERS=true พร้อม TEST_USERS_PASSWORD
#   - backend ไม่ยอมเริ่มถ้ายังมีบัญชีทดสอบรหัส password123 ให้รัน
#     npm run test-users:set-password (ในโฟลเดอร์ backend) ตั้งรหัสเป็นค่าใน TEST_USERS_PASSWORD ก่อน
# TEST_USERS_PASSWORD ยาวอย่างน้อย 12 ตัวอักษร ห้าม commit ค่าจริง
# TEST_USERS_PASSWORD=
# SEED_TEST_USERS=
# เครื่องใหม่ที่ไม่มีบัญชีทดสอบ: seed สร้าง SuperAdmin คนนี้ให้เฉพาะเมื่อยังไม่มี SuperAdmin เลย
# (รหัสยาวอย่างน้อย 12 ตัวอักษร)
# INITIAL_ADMIN_USERNAME=
# INITIAL_ADMIN_PASSWORD=

# Object Storage (Firmware) — MinIO ช่วงเริ่มต้น → AWS S3 ตอนใช้งานจริง
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=gps_minio_admin
OBJECT_STORAGE_SECRET_KEY=gps_minio_password
OBJECT_STORAGE_BUCKET=gps-firmware

# Legacy System Sync (config-sync-writer) — ดู Section 4.1
# ⏸ ห้ามตั้งเป็น production จนกว่าทีมจะสั่งชัดเจน (v3.4)
LEGACY_SYNC_MODE=mock              # mock | docker | production
LEGACY_SYSTEM_HOST=127.0.0.1       # docker: 127.0.0.1, production: config.dtc.co.th
LEGACY_SYSTEM_PORT=801             # docker: 801, production: 909

# Notification
# mock = บันทึก record + log อย่างเดียว (ค่าเริ่มต้น) | fcm = ส่ง push จริงผ่าน FCM (เฉพาะ type ใน FCM_ENABLED_NOTIFICATION_TYPES — task_assigned และ incident_report_*)
NOTIFICATION_MODE=mock
# FCM HTTP v1 API ใช้ Service Account JSON (ไม่ใช่ server key เดี่ยว) — FCM Legacy
# HTTP API + server key ถูก Google ปิดใช้งานแล้ว (deprecated 2023 → shut down 2024)
# ใส่ path ไปยังไฟล์ service-account.json ที่ดาวน์โหลดจาก Firebase Console
# (Project Settings → Service accounts) — ค่านี้เป็น placeholder ห้าม commit ไฟล์
# credential จริงเข้า repo (เพิ่ม path จริงใน .gitignore) · ใช้เฉพาะตอน
# NOTIFICATION_MODE=fcm
# path แบบ relative ถูก resolve เทียบ repo root อัตโนมัติ (RealFcmSender.resolvePath
# — convention เดียวกับ envFilePath: ['../.env']) ไม่ต้องกังวลว่ารัน backend จาก
# โฟลเดอร์ไหน · จะใส่ absolute path ก็ได้ถ้าต้องการ
# ⚠️ ไฟล์นี้กำหนดว่า push ไป Firebase project ไหน — ทดสอบ/dev ต้องชี้ไฟล์ของ project dev
# (gps-config-firmware-center-dev) เท่านั้น เช่น ./secrets/fcm-service-account.dev.json
# ห้ามชี้ไฟล์ของ production (gps-config-firmware-center) ตอนทดสอบ · ตั้งชื่อไฟล์ให้ลงท้าย
# ด้วย project (.dev / .prod) กันสลับผิด · โฟลเดอร์ secrets/ ถูก .gitignore กันไว้แล้ว
# กันพลาดในโค้ด: mode=fcm จะ throw ตอน startup ถ้า project_id ในไฟล์ไม่ลงท้าย -dev
FCM_SERVICE_ACCOUNT_PATH=./secrets/fcm-service-account.example.json
# ปล่อยให้ใช้ project ที่ไม่ลงท้าย -dev ได้ (เช่น deployment production จริง) — ปิดไว้เป็นค่าเริ่มต้น
# FCM_ALLOW_NON_DEV_PROJECT=false

# Device — mock/real แยกต่อ capability (real ยัง throw ตอน startup ทุกตัว)
DEVICE_SIMULATOR_MODE=mock         # mock | real — config simulation (POST /config/{id}/simulate + configCheck ของ /devices/{id}/simulate-config) — ชื่อ env นี้เดิมคอมเมนต์ผิดว่าครอบ firmware ด้วย แก้แล้ว (Sprint 3 #23) มี FIRMWARE_SIMULATOR_MODE แยกต่างหาก
DEVICE_CONNECTION_TEST_MODE=mock   # mock | real — POST /devices/{id}/test-connection + connectionCheck ของ /devices/{id}/simulate-config
DEVICE_CONFIG_APPLY_MODE=mock      # mock | real — POST /devices/{id}/apply-config
FIRMWARE_SIMULATOR_MODE=mock       # mock | real — POST /firmware/{id}/simulate (Sprint 3 #23)

# API Versioning
API_PREFIX=/api/v1

# CORS — origin ของ web ที่อนุญาตให้เรียก backend ข้าม origin ได้ (comma-separated
# ถ้ามีหลายค่า เช่น deploy จริงที่มีทั้ง staging/production domain)
WEB_ORIGIN=http://localhost:3000

# Reverse proxy — จำนวน proxy / load balancer ที่อยู่หน้า backend (เช่น 1) ให้ IP ใน
# Audit Log เป็นของผู้ใช้จริง ไม่ตั้ง = ปิด (ถูกต้องสำหรับ dev ที่ไม่มี proxy)
# ห้ามตั้งถ้าไม่มี proxy จริง ไม่งั้นผู้ใช้ปลอม IP ผ่าน header X-Forwarded-For ได้
# TRUST_PROXY=1

# ============================================
# ระบบเต็มชุดด้วย docker compose (profile app) ดู docs/deploy/docker-compose.md
# ============================================
# ค่าด้านล่างใช้เฉพาะ `docker compose --profile app` (backend ใน container เป็น NODE_ENV=production
# จึงต้องตั้ง JWT_SECRET เป็นค่าสุ่ม และ INITIAL_ADMIN_* หรือ SEED_TEST_USERS ข้างบน)
# พอร์ตที่เปิดหน้าระบบ (Caddy) เว็บ API และกล่อง GPS ใช้ URL เดียวกัน
# APP_PORT=8080
# จำนวน proxy หน้า backend ใน compose: Caddy อย่างเดียว = 1 / มี tunnel อีกชั้น = 2
# (แยกจาก TRUST_PROXY ข้างบนที่ใช้ตอนรัน dev server)
# APP_TRUST_PROXY=1
# Caddy เชื่อ X-Forwarded-For จาก proxy ไหน ค่าเริ่มต้นไม่เชื่อใคร ถ้ามี tunnel อยู่หน้า Caddy
# ตั้ง private_ranges คู่กับ APP_TRUST_PROXY=2 ห้ามตั้งถ้าไม่มี proxy จริง
# CADDY_TRUSTED_PROXIES=
# โหมด notification ของ backend ใน compose (mock | fcm) แยกจาก NOTIFICATION_MODE ของ dev server
# APP_NOTIFICATION_MODE=mock
