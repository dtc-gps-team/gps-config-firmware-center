// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Module: auth  (User / Role / Permission — ดู docs/architecture/RBAC_Matrix.md
// และ docs/api/openapi.yaml สำหรับ role enum ที่ยึดเป็นหลัก)
// ---------------------------------------------------------------------------

enum Role {
  SW
  Operation
  ST
  OT
  Auditor
  Admin
}

enum ActionType {
  Create
  Read
  Update
  Approve
  Override
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  fullName     String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// resource = ชื่อ path หลักใน docs/api/openapi.yaml (main) เช่น "auth", "config",
// "notifications", "tasks", "firmware", "devices" — ห้ามตั้งชื่อเดาล่วงหน้าก่อนมี
// endpoint จริง ดู RBAC_Matrix.md Section 4.1/4.2 สำหรับรายการที่ยังไม่มี endpoint
model Permission {
  id       String     @id @default(uuid())
  role     Role
  resource String
  action   ActionType

  @@unique([role, resource, action])
}

// ---------------------------------------------------------------------------
// Module: task  (มอบหมาย/ติดตามงาน — ดู 01_GPS_Build_Reference.md Section 3)
// ---------------------------------------------------------------------------

enum TaskStatus {
  pending
  in_progress
  completed
  cancelled
}

model Task {
  id          String     @id @default(uuid())
  title       String
  description String?
  assignedTo  String
  deviceId    String?
  status      TaskStatus @default(pending)
  dueDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// ---------------------------------------------------------------------------
// Module: notification  (FCM Mobile + WebSocket Web)
// ---------------------------------------------------------------------------

enum NotificationType {
  task_assigned
  config_approved
  config_rejected
  firmware_ready
  incident_alert
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  payload   Json
  read      Boolean          @default(false)
  sentAt    DateTime?
  createdAt DateTime         @default(now())
}
