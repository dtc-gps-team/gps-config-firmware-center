// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Module: auth  (User / Role / RolePermission — ดู docs/architecture/RBAC_Matrix.md
// และ docs/database/GPS_Data_Dictionary.xlsx)
//
// Role เป็นตารางจริง (ไม่ใช่ enum) เพื่อให้ Admin สร้าง/แก้ Role ใหม่ได้ผ่านหน้า
// "User / Role Management" (RBAC_Matrix.md Section 2 — ยืนยันกับทีมแล้วว่า Admin
// ต้องสร้าง Role ใหม่ได้จริง ไม่ใช่แค่ assign Role เริ่มต้น 7 ตัว)
// ---------------------------------------------------------------------------

enum ActionType {
  Create
  Read
  Update
  Approve
  Override
}

model Role {
  id          String   @id @default(uuid())
  // code = ค่าคงที่ที่โค้ด/seed อ้างอิง (แทน enum เดิม): SW, Operation, ST, OT,
  // Auditor, Admin, SuperAdmin — Role ใหม่ที่ Admin สร้างเพิ่มทีหลังตั้ง code
  // เองได้อิสระ
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  fullName     String
  roleId       String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role                          Role                    @relation(fields: [roleId], references: [id])
  tasks                         Task[]
  notifications                 Notification[]
  deviceTokens                  DeviceToken[]
  auditLogs                     AuditLog[]
  configsCreated                Config[]                @relation("ConfigCreatedBy")
  configsApproved               Config[]                @relation("ConfigApprovedBy")
  configsSuggestedToApprove     Config[]                @relation("ConfigSuggestedApprover")
  firmwareUploads               Firmware[]
  firmwareApprovals             Firmware[]              @relation("FirmwareApprovedBy")
  campaignsCreated              Campaign[]              @relation("CampaignCreatedBy")
  campaignRolloutsCreated       CampaignRollout[]       @relation("CampaignRolloutCreatedBy")
  campaignRolloutsApproved      CampaignRollout[]       @relation("CampaignRolloutApprovedBy")
  configVersionsApproved        ConfigVersion[]         @relation("ConfigVersionApprovedBy")
  configDeletionReviews         ConfigDeletionRequest[] @relation("ConfigDeletionReviewedBy")
  deviceConfigOverrides         DeviceConfigOverride[]  @relation("DeviceConfigOverrideBy")
  deviceConfigOverrideDecisions DeviceConfigOverride[]  @relation("DeviceConfigOverrideDecidedBy")
}

// ต่างจากดีไซน์เดิมใน GPS_Data_Dictionary.xlsx (source of truth) ที่วางไว้ 3 ตาราง:
// ROLE, PERMISSION (catalog สิทธิ์ตั้งชื่อไว้ล่วงหน้า เช่น "config.create"),
// ROLE_PERMISSION (join table ระหว่างสองตารางนั้น) — ตารางนี้ตัด PERMISSION
// (catalog) ออก เหลือ RolePermission ตัวเดียวที่เก็บ resource+action ตรงกับ role
// ไปเลย เหตุผล: ยังไม่มี use case ที่ต้อง reuse สิทธิ์ชุดเดียวกันข้าม Role ผ่าน
// ชื่อสิทธิ์กลาง (ยืนยันกับ kittiphong แล้ว 2026-08-28 — ทำแบบง่ายไปก่อนได้)
// TODO: sync การตัดสินใจนี้เข้า GPS_Data_Dictionary.xlsx ตัวจริงเมื่อหาไฟล์ต้นฉบับเจอ
// (ตอนนี้มีแค่สำเนาที่ปรับแก้ไว้ชั่วคราว ยังไม่ได้เซฟกลับเข้า repo)
model RolePermission {
  id       String     @id @default(uuid())
  roleId   String
  resource String
  action   ActionType

  role Role @relation(fields: [roleId], references: [id])

  @@unique([roleId, resource, action])
}

// ---------------------------------------------------------------------------
// Module: task  (มอบหมาย/ติดตามงาน — ดู docs/planning/01_GPS_Build_Reference.md Section 3)
// ---------------------------------------------------------------------------

enum TaskStatus {
  pending
  in_progress
  completed
  cancelled
}

model Task {
  id          String     @id @default(uuid())
  title       String
  description String?
  assignedTo  String
  deviceId    String?
  // Config ที่ Operation เลือกผูกกับงานตอนสร้าง Task ประเภท "ติดตั้ง/เปลี่ยน
  // config" — Mobile อ่านค่านี้ส่งเป็น body ของ POST /devices/{deviceId}/apply-config
  // ตอนทำจอ "Confirm Install" (#26 Sprint 3) · Task ประเภทอื่น (เช็คสัญญาณ,
  // เปลี่ยนซิม) configId เป็น null — Mobile ไม่เลือก config เอง แค่ apply ตัวที่
  // ผูกกับ Task ตกลงแนวทางนี้ (option a) กับ paveekornkwork-dev (A) ใน PR #81
  // comment thread (https://github.com/dtc-gps-team/gps-config-firmware-center/pull/81)
  //
  // onDelete: SetNull (default ของ optional relation) — สอดคล้องกับ
  // Campaign.config / Incident.relatedConfig (nullable Config FK ตัวอื่น) การลบ
  // Config ไม่ควร block หรือ cascade ลบ Task ที่เป็นงานปฏิบัติการ · ในทางปฏิบัติ
  // Config ที่ผูกกับ Task จะสถานะ approved/synced เสมอ (validate ใน
  // TaskService) จึงไม่มีทางถูก ConfigService.remove() ลบอยู่แล้ว (เช็ค
  // status === 'draft')
  configId    String?
  // Campaign ต้นทางของ Task นี้ — เดิมตั้งใจให้เป็น Task ที่เกิดจากขั้น
  // "มอบหมายผู้รับผิดชอบหน้างาน" ตอนสร้าง Campaign (Sprint 3 #21 Campaign
  // Wizard) ตัดสินใจร่วมกับ kittiphong (B) หลัง PR #144 review comment
  //
  // **แก้ไข 2026-09-14:** หัวหน้าแก้ scope ว่า Campaign ไม่มอบหมายงานให้ช่าง
  // หน้างานอีกต่อไป (เป็นหน้าที่ของระบบแยกที่บริษัทมีอยู่แล้ว) —
  // `CampaignService.create()` ไม่สร้าง Task แล้ว field นี้จึงไม่มีทางถูกตั้ง
  // ค่าจาก path นี้อีก (เป็น null เสมอในทางปฏิบัติ) เหลือไว้เผื่ออนาคตมีช่อง
  // ทางอื่นเชื่อม Task เข้ากับ Campaign — Task Management หน้าแยกเดิมก็ถูก
  // ยกเลิกถาวรไปแล้วเช่นกัน ดู web/src/app/(app)/_tasks/README.md)
  //
  // onDelete: SetNull เหมือน configId ด้านบน — ลบ Campaign ไม่ควร cascade
  // ลบ Task ที่เป็นงานปฏิบัติการจริง
  campaignId  String?
  status      TaskStatus @default(pending)
  dueDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // user id ของผู้รับผิดชอบงาน (ดู docs/api/openapi.yaml Task.assignedTo)
  assignedUser User      @relation(fields: [assignedTo], references: [id])
  config       Config?   @relation(fields: [configId], references: [id])
  campaign     Campaign? @relation(fields: [campaignId], references: [id])
}

// ---------------------------------------------------------------------------
// Module: notification  (FCM Mobile + WebSocket Web)
// ---------------------------------------------------------------------------

enum NotificationType {
  task_assigned
  config_approved
  config_rejected
  firmware_ready
  incident_alert
  config_deletion_pending
  config_deletion_grace
  // เพิ่มใหม่ (issue #226) — Per-device Config Override (issue #223):
  // แจ้ง Operation เมื่อมีคำขอ pending ใหม่ + แจ้ง ST ผู้ request เมื่อ
  // Operation ตัดสินใจแล้ว (mirror pattern config_deletion_pending)
  config_override_pending
  config_override_approved
  config_override_rejected
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  payload   Json
  read      Boolean          @default(false)
  sentAt    DateTime?
  createdAt DateTime         @default(now())

  // user id ของเจ้าของ notification (ดู docs/api/openapi.yaml Notification.userId)
  user User @relation(fields: [userId], references: [id])
}

// Push Notification (FCM) groundwork — Sprint 3 item #17, PR A ของแผน 4-PR
// (A: model+endpoint / B: ส่งจริงผ่าน FCM / C: Mobile setup+registration /
// D: Mobile handle push+deep link) รอบนี้ทำแค่ที่เก็บ device token — ยังไม่มี
// โค้ดส่ง push จริง (NotificationService mode `fcm` ยัง throw เหมือนเดิม)
//
// 1 user มีได้หลาย token (หลายเครื่อง) · unique ที่ `token` เพราะ FCM token
// เป็น identifier ของ "แอป+เครื่อง" 1 ตัว — เครื่องเดิม/แอปเดิมได้ token เดิม
// เสมอจนกว่าจะถูก refresh · ตอน register ถ้า token เดิมมีอยู่แล้วให้ upsert
// ทับ userId/updatedAt (เครื่องเปลี่ยนคนใช้ / ผู้ใช้ล็อกอินใหม่)
//
// platform: "android" | "ios" | "web" — ตอนนี้ scope แค่ Mobile แต่เผื่อ Web
// push ผ่าน service worker (FCM รองรับ) ทีหลัง · เก็บเป็น String ไม่ทำ enum
// เพราะรายการค่าอาจขยาย (เช่น "huawei") และไม่มี business logic แตกตาม platform
// ในตอนนี้ — DTO ฝั่ง endpoint คุมด้วย @IsIn([...]) พอ
//
// onDelete: Cascade (เบี่ยงจาก implicit Restrict ที่ Notification/Task ใช้)
// โดยตั้งใจ — device token เป็น client-registration ชั่วคราว สร้างใหม่ทุกครั้ง
// ที่เปิดแอป ไม่มีค่าเชิง audit/ประวัติ ลบ user แล้วเก็บ token ค้างไว้ไม่มี
// ประโยชน์ (ต่างจาก Notification/Task ที่เป็นบันทึกงาน)
model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Module: device  (Device Registration — ร่วมกัน A/B ตาม
// docs/planning/03_GPS_Detailed_Build_Steps.md Phase 0 ข้อ 8: B ใช้ทำ Device Registration Flow
// ฝั่ง Mobile ใน Phase 5, A ใช้ทำ Device Search/Override ฝั่ง Web ใน Phase 4)
//
// เบี่ยงจาก GPS_Data_Dictionary.xlsx (ตาราง DEVICE ใน "Product Hierarchy /
// Customer / Fleet"): Dictionary กำหนด FK บังคับไปที่ VEHICLE / CUSTOMER /
// HARDWARE_REVISION ซึ่งเป็นส่วนหนึ่งของ Product Hierarchy 9 ตารางที่ยังไม่มี
// model จริงในระบบตอนนี้ (ยังไม่ได้ build) — ใช้ spec MVP ของ Build Steps
// Phase 0 ข้อ 8 แทนไปก่อน (device_id/sim_number/device_model/protocol/status/
// registered_at/installed_at เท่านั้น) เพราะสร้าง FK ไปยัง model ที่ยังไม่มีไม่ได้
// และ RBAC_Matrix.md ก็ไม่มีกฎ Customer Scope รองรับ ST/OT ในตอนนี้ (เช็คแล้วไม่มี
// คำว่า "customer" ปรากฏในเอกสารเลย) — ยืนยันกับ kittiphong แล้ว 2026-08-31 ว่า
// จะเพิ่ม FK ไปยัง Vehicle/Customer/HardwareRevision ทีหลังเมื่อ model เหล่านั้น
// ถูกสร้างจริง
//
// **อัปเดต 2026-09-14 (docs/12_CustomerScope_Proposal.md เฟส B, PR #127):**
// เพิ่ม `model Customer` + `Device.customerId` (nullable FK) กลับเข้ามาแล้ว —
// ใช้เป็นมิติกรอง/bulk-assign บนหน้า Device Search เท่านั้น (ตาม mockup ที่ A
// ทำไว้ตั้งแต่แรก) ไม่ใช่ RBAC scope — ST/OT ยังเห็นทุกอุปกรณ์เหมือนเดิม
// (Customer Scope จริงยังเป็นเฟส C แยกต่างหาก ยังไม่ทำ) `Vehicle`/
// `HardwareRevision` ยังไม่ถูกสร้าง เหมือนเดิม
//
// ตั้งชื่อ enum ว่า DeviceLifecycleStatus (ไม่ใช่ DeviceStatus) เพื่อไม่ให้ปนกับ
// schema DeviceStatus ใน docs/api/openapi.yaml ซึ่งเป็นคนละแนวคิด (response
// object รวมสถานะ config+firmware ของกล่อง ไม่ใช่สถานะวงจรชีวิตของกล่องเอง)
//
// แก้ตาม review comment ของ paveekornkwork-dev (A) บน PR #38 (2026-08-31,
// GitHub PR review, ยังไม่ approve — แค่ COMMENTED ถามว่าเป็นการตัดออกโดยตั้งใจ
// หรือเปล่า): เพิ่ม deviceId String @unique แยกจาก id — id เป็น internal
// surrogate key ของ Prisma ใช้ทำ FK/index เท่านั้น ส่วน deviceId เป็นเลขที่ติดมา
// กับตัวเครื่องจริงที่ช่างกรอก/สแกนตอนลงทะเบียน (ดู docs/planning/03_GPS_Detailed_Build_Steps.md
// ข้อ 8, ข้อ 130) มี lifecycle ต่างจาก id (เปลี่ยนรูปแบบได้ตามผู้ผลิต หรือกรอกผิด
// แล้วต้องแก้ทีหลัง) แยกออกจากกันเพื่อไม่ให้กระทบ relation อื่นที่ผูกกับ Device.id
// ถ้าค่านี้ต้องแก้ในอนาคต
//
// simNumber: ไม่ใส่ @unique เต็มคอลัมน์ — ใช้ partial unique index แทน (สร้างเป็น
// raw SQL ตรงใน migration.sql เท่านั้น ดูรายละเอียดที่นั่น) unique เฉพาะ record ที่
// status != decommissioned เพื่อให้ SIM ย้ายไปเครื่องใหม่ได้หลัง decommission
// เครื่องเก่าโดยไม่ชน constraint ตัดสินใจใน PR #38 comment thread
// (https://github.com/dtc-gps-team/gps-config-firmware-center/pull/38#issuecomment-5474171067
// ถามทาง A, ตอบใน #issuecomment-5474255608 — paveekornkwork-dev, 2026-08-31)
// A เลือกทางนี้เพราะทางเลือกอื่น (simNumber nullable + เคลียร์เป็น null ตอน
// decommission) ต้องขยาย scope ไปแก้ AuditLog schema ด้วย (ยังไม่มี field เก็บ
// payload/metadata สำหรับบันทึกประวัติ SIM เก่า) ในขณะที่ partial index ไม่ต้อง
// แตะอะไรนอกตาราง Device เลย และตารางยังว่างอยู่ตอนนี้ เป็นจังหวะที่ทำ constraint
// นี้ได้ต้นทุนต่ำที่สุด ก่อนเจอปัญหาแบบ migration ของ role_as_table ถ้าปล่อยไว้
// ทำทีหลังตอนมีข้อมูลจริงแล้ว
//
// คำเตือน — Prisma migrate diff risk: Prisma schema DSL **ไม่รองรับ** partial/
// filtered unique index โดยตรง (เขียนเป็น raw SQL ใน migration.sql เท่านั้น
// เพราะ field simNumber ด้านล่างเป็น String เฉยๆ ไม่มี @unique ใดๆ) ผลคือ Prisma
// "ไม่รู้จัก" index นี้จาก schema — ครั้งต่อไปที่รัน `prisma migrate dev` หรือ
// `prisma migrate diff` แล้วแตะตาราง Device (แก้ field อื่น เพิ่ม field ใหม่ ฯลฯ)
// Prisma อาจ generate migration ที่มี `DROP INDEX "Device_simNumber_active_key"`
// โดยไม่ตั้งใจ (คิดว่า schema ไม่มี index นี้จริงๆ) **ต้องเช็ค diff ด้วยตาทุกครั้ง
// ก่อน apply migration ใหม่ที่แตะตาราง Device** ถ้าเจอ DROP INDEX นี้หลุดมาให้ลบ
// บรรทัดนั้นออกจาก migration ก่อน apply
// ---------------------------------------------------------------------------

enum DeviceLifecycleStatus {
  registered
  installed
  decommissioned
}

// Customer (docs/12_CustomerScope_Proposal.md เฟส B, PR #127) — field ตรงตาม
// GPS_Data_Dictionary.xlsx เท่าที่ยืนยันได้จาก schema DMS เดิมที่พี่เลี้ยงให้มา
// (§3.5 ของเอกสาร: คอลัมน์ `customer`/`cus_id` ยืนยันว่า entity นี้มีจริง) —
// `companyName` บังคับ+unique (กัน dropdown filter ในหน้า Device Search มีชื่อ
// ซ้ำสะกดต่างกัน) ฟิลด์อื่นเป็น optional เพราะยังไม่ยืนยันว่า MVP ต้องกรอกครบ
// ทุกช่อง — `priorityTier` เก็บเป็น string เฉยๆ ไม่ทำ enum เพราะยังไม่ยืนยันค่า
// จริงจากพี่เลี้ยง (docs/12 §8 คำถามเปิดข้อ 4) ใช้แค่แสดงผล ไม่มี logic ผูกอยู่
model Customer {
  id           String   @id @default(uuid())
  companyName  String   @unique
  contactName  String?
  email        String?
  phone        String?
  priorityTier String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  devices Device[]
}

// เพิ่มใหม่ (issue #209, docs/15 — ย่อจากลำดับชั้น 4 ระดับใน
// GPS_Config_Firmware_Center_Design.pdf §4.1-4.2/§14.1 เหลือ entity เดียว
// ดู comment เหนือ Device.deviceModel ด้านล่างเรื่อง deviation นี้) เป็น
// canonical registry ของ "รุ่นสินค้า" แทน string อิสระที่กระจัดกระจายอยู่
// ในหลายตาราง (Device/Config/Firmware/ConfigFieldDefinitionModelSupport)
enum DeviceModelStatus {
  active // ยังผลิต/สั่งซื้อได้ปกติ
  discontinued // เลิกผลิตแล้ว แต่เครื่องที่ใช้งานอยู่ยังทำงานได้ตามปกติ
}

model DeviceModel {
  id                 String            @id @default(uuid())
  // ต้องตรงกับ string เดิมที่ใช้อยู่แล้วทุกจุดเป๊ะ (เช่น "GT06N") — Device/
  // Config/Firmware ยังอ้าง string นี้อยู่ ไม่ได้ migrate ไปใช้ modelId ทั้งระบบ
  // ในรอบนี้ (out of scope ตาม issue #209 — ดู docs/15 หัวข้อ 5)
  name               String            @unique
  manufacturer       String?
  // โปรโตคอลที่รุ่นนี้รองรับได้ — บังคับอย่างน้อย 1 ค่าตอนสร้าง (DTO
  // @ArrayMinSize(1)) และ ConfigService บังคับ validate จริงว่า
  // Config.protocol ต้องอยู่ในลิสต์นี้ก่อนสร้าง/แก้ไข (issue #209 ข้อ 4 —
  // ตัดสินใจ enforce เข้มงวด ไม่ใช่แค่ dropdown ช่วยเฉยๆ เพราะ backfill
  // มีข้อมูลจริงรองรับอยู่แล้ว)
  supportedProtocols String[]
  status             DeviceModelStatus @default(active)
  // Warranty/lifecycle ต่อรุ่น — optional เพราะรุ่นที่ backfill เข้ามาตอน
  // migration ส่วนใหญ่ไม่มีข้อมูลนี้ให้กรอกจริง
  warrantyMonths     Int?
  endOfSupportDate   DateTime?
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  devices Device[]
}

model Device {
  id                   String                 @id @default(uuid())
  deviceId             String                 @unique
  simNumber            String
  // Deviation จาก GPS_Config_Firmware_Center_Design.pdf §4.1-4.2/§14.1
  // (เอกสารต้นฉบับพี่เลี้ยง — ออกแบบ "รุ่นอุปกรณ์" เป็นลำดับชั้น 4 ระดับแยก
  // entity กันจริง: Manufacturer → Product Family → Product Model → Hardware
  // Revision → Firmware Branch) — field นี้เป็น string เดียวแบนราบมาตั้งแต่
  // PR #38 ไม่เคยมี comment อธิบาย deviation นี้จนกว่า docs/15 (PR #196) จะ
  // ชี้ให้เห็น `DeviceModel` ที่เพิ่มด้านบนเป็นก้าวที่พาเข้าใกล้ต้นฉบับมากขึ้น
  // (ยังย่อกว่าอยู่ — รวม 4 ระดับเป็น entity เดียว)
  //
  // เก็บ field นี้ไว้ต่อช่วง transition — โค้ดหลายจุด (CampaignService,
  // TaskService, DeviceService เอง) ยังอ่าน string นี้ตรงๆ อยู่ — **server
  // คำนวณค่านี้ให้เองเสมอจาก `model.name` เมื่อมี `modelId`** ไม่รับเป็น
  // input แยกจาก client (issue #209 ข้อ 5 — กัน 2 ค่านี้ไม่ตรงกัน)
  deviceModel          String
  protocol             String
  // รหัสรุ่นย่อย/hardware revision ของเครื่องนี้ (เช่น "RevA", "2023Q1") —
  // string อิสระ ไม่มีทะเบียนแยก (ต่างจาก docs/15 เดิมที่เสนอ
  // DeviceModel.hardwareVersion — แก้แล้วเพราะอุปกรณ์รุ่นเดียวกันมีได้หลาย
  // รหัสรุ่นต่างกันตามรอบผลิต ไม่ใช่ 1 โมเดล = 1 hardwareVersion ตายตัว)
  // ยังไม่มี metadata/สถานะเป็นของตัวเอง (ไม่รู้ว่าต้องรองรับ protocol/
  // firmware ต่างกันไหม หรือเลิกผลิตแยกจากรุ่นแม่ได้ไหม) — ถ้าเจอ
  // requirement จริงทีหลัง ค่อยยกระดับเป็นตารางแยก mirror วิธีที่
  // deviceModel string เดิมกำลังถูกยกระดับเป็น DeviceModel ตอนนี้
  hardwareRevisionCode String?
  status               DeviceLifecycleStatus  @default(registered)
  registeredAt         DateTime               @default(now())
  installedAt          DateTime?
  // ผูกกับลูกค้า (docs/12 เฟส B) — nullable เพราะอุปกรณ์เดิมทั้งหมดยังไม่มีลูกค้า
  // ผูกไว้ (data ว่างตอน migration ไม่ใช่ orphan — เป็นค่าที่ยังไม่เคยกำหนด) ใช้
  // เป็นมิติกรอง/bulk-assign บนหน้า Device Search เท่านั้น ไม่ใช่ RBAC scope
  customerId           String?
  customer             Customer?              @relation(fields: [customerId], references: [id], onDelete: SetNull)
  // เดิม nullable ชั่วคราวตอน migration แรก (issue #209) — บังคับ NOT NULL
  // ในนี้แล้วหลัง backfill ครบทุกแถวใน seed.ts (ยืนยันด้วย query ตรง — ดู
  // migration `..._device_model_id_not_null`)
  modelId              String
  model                DeviceModel            @relation(fields: [modelId], references: [id])
  configOverrides      DeviceConfigOverride[]
}

// ---------------------------------------------------------------------------
// Module: audit  (AuditLog — ดู docs/architecture/RBAC_Matrix.md Section 2
// แถว "Audit Log" และหลัก Auditor เป็น read-only role อิสระ)
//
// Append-only โดยธรรมชาติ — ไม่มี update/delete บน record ที่บันทึกไปแล้ว จึงไม่มี
// updatedAt เหมือน model อื่น
//
// field ตรงตาม GPS_Data_Dictionary.xlsx (ตาราง AUDIT_LOG) ตัวต่อตัว: ไม่มี
// resource/payload แยกต่างหาก ใช้ auditModule + action + ipAddress ตามที่
// Dictionary ระบุจริง — ยืนยันกับ kittiphong แล้ว 2026-08-31 ว่าตอนนั้นยังไม่มี
// use case ที่ต้องเก็บ payload โครงสร้างเพิ่มเติม
//
// **อัปเดต (2026-09-22, issue #205, feedback พี่เลี้ยง):** ยืนยันมติใหม่แล้วว่า
// ต้องการ — เพิ่ม `metadata Json?` (deviation จาก Data Dictionary โดยตั้งใจ
// เพื่อรองรับการตรวจสอบย้อนหลังที่ละเอียดขึ้น) mirror pattern เดียวกับ
// `Incident.metadata` ทุกประการ: nullable, ทุก key ใน metadata เป็น optional,
// เก็บเฉพาะข้อมูลที่ "สำคัญ/จำเป็นต่อการตรวจสอบ" ไม่ใช่ backfill ทุก AuditLog
// write ที่มีอยู่แล้วในระบบ — ดู src/audit/audit-log-metadata.ts
// ---------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(uuid())
  userId      String
  auditModule String
  action      String
  ipAddress   String?
  // รายละเอียดเชิงโครงสร้างของแถวนี้ (AuditLogMetadata — ทุก key optional)
  // **ตั้งใจไม่เก็บค่าจริงของ field ที่ apply (เช่น Config.fields ทั้งก้อน)** —
  // GET /audit-logs เปิดให้ Operation/ST/OT/Auditor/Admin อ่านได้ ถ้าเก็บค่า
  // field ตรงๆ อาจมีค่าอ่อนไหว (COMMAND_PASSWORD, SOS_NUMBER_1 ฯลฯ) รั่วออกไป
  // ให้ role ที่ไม่ควรเห็น — เก็บแค่ "มี field อะไรบ้าง" (ชื่อ ไม่ใช่ค่า) พอ
  metadata    Json?
  createdAt   DateTime @default(now())

  // user id ของผู้ทำรายการ (ดู GPS_Data_Dictionary.xlsx AUDIT_LOG.user_id)
  user User @relation(fields: [userId], references: [id])
}

// ---------------------------------------------------------------------------
// Module: config — MVP เดียวกับแนวทาง Device (PR #38): เบี่ยงจาก
// GPS_Data_Dictionary.xlsx ที่ออกแบบไว้ 11 ตาราง (CONFIG_TEMPLATE,
// DEVICE_CONFIG, CONFIG_HISTORY, CONFIG_CHANGE_REQUEST ฯลฯ) ใช้แค่ field
// ตาม openapi.yaml DeviceConfigDraft แทน — issue #25
//
// UPDATE (schema follow-up ก่อน #26): เพิ่ม versions -> ConfigVersion
// (ดูด้านล่าง) — สถานะยังเป็นขั้นเดียวเหมือนเดิม มีแค่ Operation อนุมัติได้
// จริง (ยืนยันกับ kittiphong บน issue #26: ไม่เพิ่ม sw_approved)
// ---------------------------------------------------------------------------

enum ConfigStatus {
  draft
  testing
  approved
  rejected
  synced
}

model Config {
  id                  String       @id @default(uuid())
  // ชื่อ Config ที่คนตั้ง — unique ทั้งระบบ กัน SW สร้าง/แก้แล้วชนกันเอง หรือมี
  // config ซ้ำที่แยกไม่ออกว่าอันไหนคืออันจริง (มติ Sprint 1 review ข้อ 4 —
  // ดู docs/09_Sprint1_Review_Decisions.md §2)
  //
  // Deviation จาก Data Dictionary: model Config ทั้งตัวเป็นเวอร์ชันย่อของดีไซน์
  // template-based ใน DD (CONFIG_TEMPLATE + CONFIG_TEMPLATE_VERSION + ...) —
  // field นี้เทียบเท่ากับ CONFIG_TEMPLATE.template_name ของ DD แต่บังคับ unique
  // ทั้งระบบตามมติ review ข้างต้น
  name                String       @unique
  deviceModel         String
  protocol            String
  // คำอธิบายสั้นๆ ว่า Config ชุดนี้ทำไว้เพื่ออะไร — ไม่บังคับ (optional)
  // เทียบเท่า CONFIG_TEMPLATE.description ของ Data Dictionary (สอดคล้อง ไม่ใช่
  // deviation) · ใช้แสดงในหน้ารายละเอียด / wizard สร้าง Config (frame 07)
  description         String?
  status              ConfigStatus @default(draft)
  fields              Json
  createdBy           String
  approvedBy          String?
  // "ผู้อนุมัติที่ SW เจาะจง" (Approval Center — Sprint 3 #19) — SW เลือกตอนกด
  // decide(passed:true) ว่าอยากให้ Operation คนไหนดูเป็นพิเศษ · **ไม่ผูกมัด**:
  // Operation คนอื่นก็ approve ได้ (POST /config/{id}/approve เช็คแค่ role) ·
  // แค่ hint สำหรับ tab "เจาะจงถึงฉัน" · nullable — Config เดิมที่ไม่มีค่านี้
  // ใช้ได้ปกติ · ยังไม่มี endpoint แก้ค่านี้หลัง decide (v1 — เพิ่มทีหลังได้)
  suggestedApproverId String?
  // soft-delete ของ flow "คำขอลบ Config อัตโนมัติ" (docs/11 Part A) — เซ็ตตอน
  // SuperAdmin approve คำขอลบ · ทุก query อ่านของ config.service.ts เติม
  // `where: { deletedAt: null }` · คนละเรื่องกับ ConfigService.remove() (hard
  // delete ของ SW ลบ draft ตัวเอง) ที่ยังทำงานเหมือนเดิม
  deletedAt           DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  creator           User                    @relation("ConfigCreatedBy", fields: [createdBy], references: [id])
  approver          User?                   @relation("ConfigApprovedBy", fields: [approvedBy], references: [id])
  suggestedApprover User?                   @relation("ConfigSuggestedApprover", fields: [suggestedApproverId], references: [id])
  campaignRollouts  CampaignRollout[]
  incidents         Incident[]
  versions          ConfigVersion[]
  tasks             Task[]
  deletionRequests  ConfigDeletionRequest[]
  deviceOverrides   DeviceConfigOverride[]
}

// เพิ่มใหม่: เก็บ snapshot ของ Config แบบ append-only ทุกครั้งที่ approve
// (Phase 1 ข้อ 9 / #26) — ใช้เป็นฐานของ Rollback ใน Phase 4 (#28)
model ConfigVersion {
  id            String   @id @default(uuid())
  configId      String
  // running number ต่อ config (1, 2, 3...) — ให้ UI/rollback อ้าง "เวอร์ชัน N"
  // ได้ตรงๆ ไม่ต้องพก UUID และ @@unique ด้านล่างเป็น backstop กัน approve ชนกัน
  versionNumber Int
  fields        Json
  deviceModel   String
  protocol      String
  // ชื่อ field เดิมหมายถึง "ผู้อนุมัติ" (เขียนตอน ConfigService.approve()) —
  // issue #185 (ST Override) mirror การสร้าง ConfigVersion แบบเดียวกันทุก
  // ประการ แต่ actor ไม่ใช่ผู้อนุมัติจริง เป็น ST ที่ทำ override — ใช้ field
  // เดิมนี้เก็บ id ผู้ทำรายการ (semantic กว้างขึ้นเป็น "ผู้ทำให้เกิด version
  // นี้" ไม่ใช่แค่ "ผู้อนุมัติ" เท่านั้น) แยกแยะ 2 กรณีได้จาก `reason` ด้านล่าง
  // (null = มาจาก approve() ปกติ, มีค่า = มาจาก override)
  approvedBy    String
  approvedAt    DateTime @default(now())
  // เหตุผลของ override — บังคับกรอกตอนยิง POST /config/{id}/override (PDF
  // §19 ข้อ 24: "ทุกการ Override ต้องมีผู้ดำเนินการ เหตุผล และ Audit Log")
  // เป็น null เสมอสำหรับ version ที่มาจาก approve() ปกติ (ไม่ใช่ override)
  reason        String?

  // onDelete: Restrict ประกาศเจตนาให้ชัด — config ที่มี version จะสถานะ
  // approved/synced เสมอ (กลับไป draft ไม่ได้หลัง approve) จึงไม่มีทางถูก
  // ConfigService.remove() ลบอยู่แล้ว (เช็ค status === 'draft')
  config   Config @relation(fields: [configId], references: [id], onDelete: Restrict)
  approver User   @relation("ConfigVersionApprovedBy", fields: [approvedBy], references: [id])

  @@unique([configId, versionNumber])
  @@index([configId])
}

enum DeviceConfigOverrideStatus {
  pending
  approved
  rejected
}

// เพิ่มใหม่ (issue #223 — Per-device Config Override) — mirror ConfigVersion
// เกือบทั้งหมด ต่างกันแค่ scope: ตัวนี้ผูกกับ**อุปกรณ์เครื่องเดียว** ไม่ใช่ทั้ง
// Config ที่ใช้ร่วมกันหลายเครื่อง (ปัญหาที่ paveekornkwork-dev (A) ชี้ไว้ระหว่าง
// รีวิว PR #222 — override เดิม (issue #185, `POST /config/{configId}/override`)
// แก้ `Config.fields` ทั้งชุด กระทบทุกอุปกรณ์ที่ใช้ Config เดียวกัน) —
// `GET /devices/{deviceId}/config` (`DeviceService.getCurrentConfig()`) merge
// เฉพาะแถว `status: approved` ทับ `Config.fields` (base) ก่อนคืนกลับ ไม่แตะ
// `Config`/`ConfigVersion` เดิมเลย — endpoint เดิม `POST /config/{configId}/override`
// (Web, PR #199) จะถูก deprecate โดย A แยก PR หลัง PR #225 merge (มติบันทึกใน
// issue #223, ดู PR #225 review — เลือกรวมเป็น mechanism เดียว ไม่คงคู่กัน
// ต่างจากที่ร่างไว้ตอนแรกใน PR #225)
//
// **มติ 2026-09-24 (บันทึกใน issue #223, request changes บน PR #225 โดย A):**
// override ไม่มีผลทันทีอีกต่อไป — ต้องผ่าน Operation อนุมัติก่อน (Separation
// of Duty เดิม) เหมือน Config ปกติ: ST ส่งคำขอ (`status: pending`) →
// Operation อนุมัติ/ปฏิเสธ (`approved`/`rejected`, เก็บ `decidedBy`/
// `decidedAt`/`rejectReason`) → หลังอนุมัติแล้วช่างต้องกด apply Config เข้า
// เครื่องเองอีกครั้งผ่าน `apply-config` เดิม (ยังไม่ทำใน PR นี้ — แยกเป็น PR
// ถัดไปตามที่ A เสนอ) — เครื่องหนึ่งมีคำขอ `pending` พร้อมกันได้แค่ 1 รายการ
// (`DeviceService.overrideDeviceConfig()` เช็คก่อนสร้าง 409 ถ้ามีอยู่แล้ว)
//
// **`deviceId` เป็น FK จริงไป `Device.deviceId`** (unique business key ไม่ใช่
// `Device.id` UUID ภายใน — ตรงกับ convention ที่ endpoint อื่นทุกตัวอ้างอุปกรณ์
// ด้วยเลขเครื่องจริงเสมอ) — **ตั้งใจต่างจาก** `Task.deviceId`/
// `CampaignTarget.deviceId` เดิมที่เป็น string หลวมๆ ไม่มี FK คุมเลย (รอบนี้
// อยากได้ FK จริงคุ้มครองข้อมูลให้แน่นขึ้น เพราะเป็นตารางใหม่ ไม่มี legacy
// data ที่หลุด convention ต้อง normalize แบบสองตารางเดิม)
//
// **Deviation จาก `GPS_Data_Dictionary.xlsx` โดยตั้งใจ (ตาม CLAUDE.md หัวข้อ
// Deviation, ชี้โดย A ระหว่างรีวิว PR #225):** DD มีตาราง
// `DEVICE_CONFIG_OVERRIDE` อยู่แล้ว แต่เป็น **1 แถวต่อ 1 field**
// (`config_definition_id` FK + `value` เดี่ยว) และ FK ไป `DEVICE(id)` — ตัวนี้
// เก็บ **snapshot สะสมทั้งก้อนเป็น version** (`fields` JSON หลาย field ต่อแถว)
// mirror สไตล์ `ConfigVersion` แทน (เหตุผลเดียวกับที่ `ConfigVersion` เก็บ
// แบบ snapshot ไม่ใช่ 1 แถวต่อ field) และ FK ไป `Device.deviceId` ไม่ใช่
// `Device.id` (ดูย่อหน้าบน) — อีกจุด: DD เขียนว่า override ทำบน **Web
// เท่านั้น** (ตัดออกจาก Mobile ตั้งแต่ต้น) แต่มติล่าสุด (2026-09-24) เปลี่ยน
// ให้ช่างหน้างานส่งคำขอผ่าน Mobile ได้ (ต้องผ่าน Operation อนุมัติเหมือนกัน
// ไม่ใช่ bypass) — เป็น deviation ที่ตั้งใจ ไม่ใช่หลุด spec เงียบๆ
model DeviceConfigOverride {
  id            String                     @id @default(uuid())
  deviceId      String
  // denormalized ไว้เพื่อ audit ว่า override ทับ Config ตัวไหน ณ ตอนนั้น —
  // "Config ปัจจุบัน" ของอุปกรณ์ (จาก Task ล่าสุดที่ completed) เปลี่ยนได้ถ้ามี
  // Confirm Install ใหม่ทับทีหลัง ค่านี้จึงเป็น snapshot ไม่ใช่ live reference
  configId      String
  // running number ต่อ**อุปกรณ์** (1, 2, 3...) mirror ConfigVersion.versionNumber
  // แต่ scope เป็นรายเครื่อง ไม่ใช่รายConfig — นับรวมทุกสถานะ (ไม่ใช่แค่
  // approved) กัน versionNumber ชนกันหลัง reject แล้วส่งคำขอใหม่
  versionNumber Int
  fields        Json
  // เหตุผลของคำขอ override — บังคับกรอกเสมอ (mirror ConfigVersion.reason แต่ที่นี่
  // ไม่ nullable เพราะทุกแถวมาจาก override เท่านั้น ไม่มี flow อื่นที่สร้างแถวนี้
  // แบบ "ปกติ" เหมือน ConfigVersion ที่มาได้ทั้งจาก approve()/override())
  reason        String
  status        DeviceConfigOverrideStatus @default(pending)
  overriddenBy  String
  overriddenAt  DateTime                   @default(now())
  // ผู้อนุมัติ/ปฏิเสธ — null จนกว่า Operation จะตัดสินใจ (status ยัง pending)
  decidedBy     String?
  decidedAt     DateTime?
  // เหตุผลตอนปฏิเสธ — optional (Operation อาจไม่ระบุก็ได้) ไม่มีความหมายถ้า
  // status ไม่ใช่ rejected
  rejectReason  String?

  // onDelete: Restrict (ไม่ใช่ Cascade เดิม — แก้ตาม review A บน PR #225) ทั้ง
  // Device และ Config — ประวัติคำขอ/override เป็นข้อมูลเชิง audit ไม่ควรหาย
  // ไปเงียบๆ ตอนลบอุปกรณ์หรือ Config (ในทางปฏิบัติทั้งคู่ไม่มีทาง hard-delete
  // อยู่แล้วตอนนี้ — ไม่มี endpoint ลบ Device เลย, Config ลบได้แค่ตอนยัง draft)
  device    Device @relation(fields: [deviceId], references: [deviceId], onDelete: Restrict)
  config    Config @relation(fields: [configId], references: [id], onDelete: Restrict)
  overrider User   @relation("DeviceConfigOverrideBy", fields: [overriddenBy], references: [id])
  decider   User?  @relation("DeviceConfigOverrideDecidedBy", fields: [decidedBy], references: [id])

  @@unique([deviceId, versionNumber])
  @@index([deviceId])
  @@index([status])
}

// เพิ่มใหม่ (docs/11 Part A — คำขอลบ Config อัตโนมัติ): scheduled job รายวัน
// กวาดหา Config ที่เข้าเกณฑ์ §2 (draft/rejected · ไม่ผูก Task/Campaign/Incident
// · updatedAt เก่ากว่า 90 วัน · ไม่มีคำขอ pending ค้าง · ไม่อยู่ใน cooldown 90
// วันหลังเคยถูก reject) แล้วสร้างคำขอ pending + แจ้ง SuperAdmin/ผู้สร้าง
// SuperAdmin เท่านั้นที่ approve (soft delete) / reject (Config อยู่ต่อ + เข้า
// cooldown) · SW/ผู้สร้างกด "เก็บไว้" ระหว่าง grace period 7 วัน -> cancelled
//
// ไม่ใช้ approval framework กลาง (ยืนยันตามรีวิว B — PR #99 §5 ข้อ 2)
enum ConfigDeletionRequestStatus {
  pending
  approved
  rejected
  cancelled
}

model ConfigDeletionRequest {
  id           String                      @id @default(uuid())
  configId     String
  // เหตุผลที่ job สร้างคำขอ — human-readable ให้ SuperAdmin อ่านตอนตัดสิน
  reason       String
  status       ConfigDeletionRequestStatus @default(pending)
  detectedAt   DateTime                    @default(now())
  reviewedBy   String?
  reviewedAt   DateTime?
  // เหตุผลตอน reject (SuperAdmin กรอก) — ใช้แสดงให้ผู้สร้างเห็นว่าทำไมไม่ให้ลบ
  decisionNote String?

  // onDelete: Cascade — ถ้า Config ถูก hard-delete จริง (SW ลบ draft ตัวเอง
  // ผ่าน ConfigService.remove ก่อน job รัน) คำขอลบที่ผูกอยู่ก็ไม่มีความหมาย
  // แล้ว ลบตามไปด้วย (ต่างจาก soft-delete ที่ deletedAt != null แต่ row ยังอยู่)
  config   Config @relation(fields: [configId], references: [id], onDelete: Cascade)
  reviewer User?  @relation("ConfigDeletionReviewedBy", fields: [reviewedBy], references: [id])

  @@index([configId])
  @@index([status])
}

// เพิ่มใหม่: "Config Definition Lookup" เก็บนิยามฟิลด์ Config (~262 ฟิลด์
// ตามเอกสารต้นฉบับ ยังไม่ครบตอนนี้) — SW สร้างเองผ่าน `POST /config-definitions`
// ทีละตัวตามที่ใช้จริง (self-service ไม่ต้องรออนุมัติ — ตัดสินใจร่วมกับ B และ
// พี่เลี้ยง 2569-09) ไม่ต้องกรอกให้ครบทุก field ล่วงหน้า
model ConfigFieldDefinition {
  id              String   @id @default(uuid())
  fieldName       String   @unique
  dataType        String
  allowedValues   String[]
  required        Boolean  @default(false)
  unknownSpec     Boolean  @default(false)
  description     String?
  // หน่วยของค่า field นี้ (เช่น "วินาที", "KB", "เมตร", "%") — ไม่บังคับ
  // เป็น metadata สำหรับแสดงผลข้างช่องกรอกตอนสร้าง Config (frame 08) เท่านั้น
  // ไม่ถูกใช้ใน validateFields
  unit            String?
  // ST override ค่า field นี้บนอุปกรณ์ (ผ่าน POST /config/{id}/override) ได้ไหม
  // — ตั้งโดย ConfigEngineer ตอนสร้าง/แก้ field ใน Parameter Library (issue #185)
  // ตั้งใจให้ชื่อ field สื่อว่า "เฉพาะ ST" ตรงตัว — OT ไม่ได้สิทธิ์นี้เลยไม่ว่า
  // ค่านี้จะเป็นอะไร (ไม่มี RBAC grant `config-override` ให้ OT ตั้งแต่ seed.ts)
  // ถ้าทีมต้องการเปิดให้ role ที่ 3 override ได้ทีหลัง ค่อยขยายเป็น
  // role-list แทน Boolean เดี่ยว (YAGNI — ตัดสินใจร่วมกับ B 2026-09-18)
  stOverridable   Boolean  @default(false)
  // 3 field ถัดไปตรงกับ `docs/GPS_Config_Firmware_Center_Design.pdf` §5.1
  // (ตาราง field ของ config_key) + §14.2 (ตัวอย่าง DDL) ตรงตัว — เพิ่มแบบ
  // additive ล้วน ไม่ต้องรอสเปกฟิลด์เต็ม ~262 ค่า เพราะเป็น metadata
  // ง่ายๆ ไม่ผูกกับ validateFields เหมือน `unit` ด้านบน
  //
  // จัดหมวดหมู่ field สำหรับแสดงผล (PDF ตัวอย่าง: GPS, Network, Server, CAN,
  // Sensor, Camera, Security) — ไม่บังคับ, ไม่ใช่ enum เพราะยังไม่รู้ชุดหมวด
  // เต็มจนกว่าจะมีสเปกฟิลด์จริง
  category        String?
  // field ที่เก็บค่าอ่อนไหว (เช่น COMMAND_PASSWORD, APN_PASSWORD, SOS_NUMBER_1
  // ที่ seed ไว้แล้ว) — ใช้ซ่อนค่าบนหน้าจอ (input type password / mask ตอน
  // แสดงผล) ฝั่ง Web เท่านั้น ไม่ได้เข้ารหัสค่าที่เก็บใน DB เพิ่ม (นอกเหนือจาก
  // scope ของ field metadata นี้)
  sensitive       Boolean  @default(false)
  // ต้อง Restart กล่องหลังเปลี่ยนค่า field นี้ไหม — metadata แสดงผล/เตือนผู้ใช้
  // เท่านั้น ยังไม่ผูกกับ logic ใดใน backend (เช่น บังคับ Task แยกสำหรับ restart)
  restartRequired Boolean  @default(false)
  // ค่าเริ่มต้นของ field นี้ (issue #202, feedback พี่เลี้ยง) — เก็บเป็น
  // String? เหมือน pattern ของ unit/category ด้านบน (parse ตาม dataType
  // ตอนใช้งานจริง ฝั่ง Web ที่ ConfigWizard ตอนสร้าง Config ใหม่ — ไม่ใช่ตอน
  // Clone ซึ่งยังใช้ค่าจาก Config ต้นทางเหมือนเดิม) ไม่ผูกกับ validateFields
  defaultValue    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  supportedModels ConfigFieldDefinitionModelSupport[]
}

// ตาราง join ที่ B เปิด gap ไว้ใน PR #51 (Section 6, RBAC_Matrix.md) — ผูก field
// definition หนึ่งตัวเข้ากับ deviceModel/protocol ที่ใช้ได้ (หลายคู่ต่อ field
// เดียวได้) ระบุตอนสร้าง field เลย (ตัดสินใจร่วมกับ B และพี่เลี้ยง 2569-09:
// ไม่ให้ระบบกรองอัตโนมัติที่หน้า Template ด้วยการเดา ต้องมีข้อมูลนี้ชัดเจน
// ตั้งแต่ตอนสร้าง parameter)
model ConfigFieldDefinitionModelSupport {
  id                String @id @default(uuid())
  fieldDefinitionId String
  deviceModel       String
  protocol          String

  fieldDefinition ConfigFieldDefinition @relation(fields: [fieldDefinitionId], references: [id], onDelete: Cascade)

  @@unique([fieldDefinitionId, deviceModel, protocol])
}

// ---------------------------------------------------------------------------
// Module: firmware — เบี่ยงจาก Data Dictionary (7 ตาราง: FIRMWARE_FILES,
// FIRMWARE_COMPATIBILITY, FIRMWARE_DELTAS ฯลฯ) ใช้ field ตาม openapi.yaml
// Firmware schema ตรงๆ — issue #25
// ---------------------------------------------------------------------------

enum FirmwareUploadStatus {
  pending
  stored
  failed
}

enum FirmwareDeviceUpdateStatus {
  unknown
  up_to_date
  pending_update
}

// Firmware Approval Lifecycle (docs/13_Role_Redesign_Proposal.md §3.2, PR
// ถัดจาก #178) — คนละมิติกับ FirmwareUploadStatus (นั่นคือผลทางเทคนิคของการ
// อัปโหลดไฟล์ ไม่ใช่การตัดสินใจเรื่องคุณภาพ) ไม่มี `draft` (อัปโหลดสำเร็จ =
// พร้อมให้ QA ตรวจทันที ไม่มีขั้น "แก้ไปเรื่อยๆ ก่อนส่ง" แบบ Config) และไม่มี
// `synced` (concept "sync เข้าระบบเดิม" กำลังถูกตัดออกทั้งระบบตาม Issue #157)
enum FirmwareApprovalStatus {
  pending_review
  approved
  rejected
}

model Firmware {
  id                       String                     @id @default(uuid())
  version                  String
  deviceModelCompatibility String[]
  uploadStatus             FirmwareUploadStatus       @default(pending)
  deviceUpdateStatus       FirmwareDeviceUpdateStatus @default(unknown)
  // 3 field ด้านล่าง — `01_GPS_Build_Reference.md` §3 ระบุไว้แต่แรกว่าตาราง
  // Firmware ต้องมี "path ใน Object Storage" แต่ schema เดิม (ก่อน Sprint 3
  // #23) ไม่มี field เก็บ reference ไฟล์เลยสักตัว — ปิด gap นี้ตอน implement
  // module จริง (ไม่ใช่แค่ objectKey เฉยๆ — เก็บชื่อไฟล์เดิม+ขนาดไว้ด้วยเพื่อ
  // แสดงผลบนหน้าเว็บ/ตรวจสอบภายหลัง โดยไม่ต้องไปเรียก HEAD object ที่ MinIO)
  objectKey                String
  originalFilename         String
  fileSizeBytes            Int
  uploadedBy               String
  uploadedAt               DateTime                   @default(now())
  // Firmware Approval Lifecycle — mirror Config.status/approvedBy (ดู comment
  // เหนือ enum) `approvedBy` เป็น null จนกว่า QAEngineer จะตัดสินใจ (approve
  // หรือ reject ก็ไม่ตั้งค่านี้ตอน reject — mirror ConfigService.reject ที่ไม่
  // แตะ approvedBy เช่นกัน)
  approvalStatus           FirmwareApprovalStatus     @default(pending_review)
  approvedBy               String?

  uploader         User              @relation(fields: [uploadedBy], references: [id])
  approver         User?             @relation("FirmwareApprovedBy", fields: [approvedBy], references: [id])
  campaignRollouts CampaignRollout[]
  incidents        Incident[]
}

// ---------------------------------------------------------------------------
// Module: campaign — ไม่มี schema ใน openapi.yaml (RBAC_Matrix.md ยืนยัน
// เป็น Gap) ออกแบบจาก flow ที่ระบุใน RBAC Matrix: Campaign Wizard (สร้าง —
// Operation), Campaign Monitor (ติดตาม Failure Rate — Operation) เบี่ยงจาก
// Data Dictionary (DEPLOYMENT_CAMPAIGN + CAMPAIGN_BATCHES + CAMPAIGN_TARGET
// + CAMPAIGN_ASSIGNMENT แยก 4 ตาราง มี rollout strategy/batch/canary/
// auto-pause ที่ยังไม่ใช่ MVP) เหลือ counter รวมแทน per-target tracking
// ละเอียด
//
// **แก้ไข 2026-09-14:** เดิม comment ตรงนี้ระบุว่า target list มีไว้ "ถึงจะ
// สร้าง Task ต่อเครื่องได้" — หัวหน้าแก้ scope ว่า Campaign มีไว้ติดตาม/
// บำรุงรักษาอุปกรณ์เป็นกลุ่มเท่านั้น (อัปเดต Config/Firmware + สังเกตความ
// ผิดปกติ) ไม่ใช่มอบหมายงานให้ช่างหน้างาน (เป็นหน้าที่ของระบบแยกที่บริษัทมี
// อยู่แล้ว) `CampaignService.create()` จึงไม่สร้าง `Task` อีกต่อไป —
// `Campaign.tasks` (เดิม) จึงถูกตัดออกทั้งหมดในรอบแก้ไขถัดไปด้านล่าง
//
// **แก้ไข 2026-09-24 (Campaign Monitor #22 — แยก "กลุ่ม" ออกจาก "รอบ push"):**
// ของเดิม 1 `Campaign` ผูก payload+approval+target ไว้ก้อนเดียว ยิงได้ครั้งเดียว
// จบ — ไม่ตรงกับ intent "ติดตาม/บำรุงรักษาอุปกรณ์เป็นกลุ่ม" ที่กลุ่มควรอยู่ยาว
// แล้ว push payload ใหม่ได้หลายรอบ จึงแตกเป็น 2 ระดับ:
//   - `Campaign` = กลุ่มอุปกรณ์ถาวร (แค่ name/description/สมาชิก) ไม่มี
//     payload/status/approval ติดตัวอีกต่อไป
//   - `CampaignRollout` = 1 รอบ push Config หรือ Firmware เข้ากลุ่ม — รับ field
//     payloadType/configId/firmwareId/status/approval/successCount/
//     failureCount ทั้งหมดที่เคยอยู่บน `Campaign` มาไว้ที่นี่แทน
// กลุ่มหนึ่ง **รัน rollout ได้ทีละรอบเท่านั้น** (เช็คที่ service layer — ห้าม
// สร้างรอบใหม่ถ้ายังมีรอบที่ `pending_approval`/`active` ค้างอยู่) MVP นี้ยัง
// ไม่เปิดให้เพิ่ม/ลบสมาชิกกลุ่มทีหลัง (`CampaignTarget` fix ตอนสร้างกลุ่ม
// เท่านั้น — เป็นงานถัดไป) และ rollout หนึ่งรอบ default = สมาชิกทั้งกลุ่ม
// แต่เลือกเอาบางเครื่องออกได้ตอนสร้าง (`excludeDeviceIds` ใน DTO) กันกรณีบาง
// เครื่องในกลุ่มไม่พร้อมแล้ว (เช่นปลดระวางไปแล้ว) ไม่ให้ block ทั้ง rollout
// ---------------------------------------------------------------------------

enum CampaignPayloadType {
  Config
  Firmware
}

model Campaign {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator  User              @relation("CampaignCreatedBy", fields: [createdBy], references: [id])
  targets  CampaignTarget[]
  rollouts CampaignRollout[]
  // เปล่า ไม่มีอะไรเขียนเข้าจาก module นี้ (ดู comment เหนือ `Task.campaignId`)
  // — เหลือไว้เพราะ Prisma บังคับประกาศทั้ง 2 ฝั่งของ relation
  tasks    Task[]
}

// CampaignTarget — สมาชิกกลุ่ม (deviceId เฉยๆ ไม่มี status) แยกจากผลของแต่ละ
// รอบ push ซึ่งอยู่ที่ `CampaignRolloutTarget` แทน (แก้ไข 2026-09-24)
//
// deviceId เป็น string หลวมๆ ไม่ใช่ Prisma relation ไปยัง Device.id — mirror
// `Task.deviceId` ทุกประการ (ค่านี้คือเลขเครื่องจริงจาก `Device.deviceId`
// ไม่ใช่ `Device.id` UUID ภายใน — Device model เองก็ไม่มี relation กลับมา)
//
// ไม่มี `assignedTo` ในตารางนี้ — เดิมมีแผนให้เป็น input สร้าง `Task` ต่อเครื่อง
// พร้อมมอบหมายผู้รับผิดชอบหน้างานตอน submit Campaign Wizard (ตัดสินใจร่วมกับ
// kittiphong (B) หลัง PR #144) **แก้ไข 2026-09-14:** หัวหน้าแก้ scope ว่า
// Campaign ไม่ใช่เครื่องมือมอบหมายงาน (เป็นหน้าที่ของระบบแยกที่บริษัทมีอยู่
// แล้ว) จึงตัดทั้งแนวคิด assignedTo และการสร้าง Task ออกจาก Campaign ทั้งหมด
model CampaignTarget {
  id         String   @id @default(uuid())
  campaignId String
  deviceId   String
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, deviceId])
  @@index([campaignId])
}

// Campaign Approval (แก้ครั้งที่ 39, docs/architecture/RBAC_Matrix.md) — เพิ่ม
// `pending_approval`/`rejected` ปิด gap ที่ System Design PDF §9.1/§10.2/§19
// ต้องการ Approval step ก่อน Rollout เข้า `active` จริง (เดิม v1 "ส่งพร้อมกัน
// หมด" ข้ามขั้นนี้ไปเลย) `rejected` แยกจาก MVP "ยังไม่ได้ส่ง" (ไม่มีสถานะ
// draft อีกต่อไป — rollout สร้างแล้วเป็น `pending_approval` ทันทีเสมอ ต่างจาก
// `Campaign` เดิมที่เคยมี `draft`) โดยตั้งใจ mirror `ConfigStatus.rejected` —
// ให้เห็นชัดว่าเคยถูกปฏิเสธมาก่อน ไม่ใช่แค่ยังไม่เคยส่งอนุมัติ — Operation
// แก้ไขแล้วส่งอนุมัติใหม่ได้ผ่าน `POST /campaigns/{id}/rollouts` อีกรอบ
// (rollout เดิมที่ rejected ค้างไว้เป็นประวัติ ไม่มี PATCH แก้ rollout เดิม)
enum CampaignRolloutStatus {
  pending_approval
  active
  rejected
  completed
  cancelled
}

// CampaignRollout — 1 รอบ push Config หรือ Firmware เข้ากลุ่มอุปกรณ์
// (`Campaign`) หนึ่งกลุ่ม (แก้ไข 2026-09-24 — เดิม field พวกนี้อยู่บน
// `Campaign` ตรงๆ ดู comment เหนือ `model Campaign`)
//
// TODO(#Campaign module): payloadType กับ configId/firmwareId ไม่มี DB/Prisma
// constraint บังคับ mutual exclusivity (เช่น payloadType=Config ต้องมี
// configId และ firmwareId ต้องเป็น null) — ยืนยันกับ kittiphong แล้วใน PR #25
// review ว่าตั้งใจปล่อยให้ service layer เป็นคนบังคับ ไม่ใช่ oversight
// เหตุผลที่ไม่ทำเป็น DB-level CHECK constraint: (1) ยังไม่มี business logic
// รองรับเลยสักบรรทัด เพิ่ม constraint ไปก่อนอาจต้องแก้อีกรอบถ้า requirement
// เปลี่ยน (2) แบบเดียวกับ Device.simNumber partial index — raw SQL constraint
// ที่ Prisma schema DSL มองไม่เห็นมีความเสี่ยงโดน `prisma migrate dev`/`diff`
// generate DROP CONSTRAINT ทิ้งโดยไม่ตั้งใจถ้าไม่ระวัง
model CampaignRollout {
  id           String                @id @default(uuid())
  campaignId   String
  payloadType  CampaignPayloadType
  configId     String?
  firmwareId   String?
  status       CampaignRolloutStatus @default(pending_approval)
  targetCount  Int                   @default(0)
  successCount Int                   @default(0)
  failureCount Int                   @default(0)
  createdBy    String
  // Separation of Duty (แก้ครั้งที่ 39) — Operation สร้าง Rollout เอง จึงต้อง
  // กันไม่ให้อนุมัติงานตัวเอง (เช็คที่ service layer เทียบ actor.id ตอน
  // approve/reject กับ field นี้ ไม่ใช่ DB constraint — mirror `Config.approvedBy`
  // ที่ปล่อยให้ service เป็นคนบังคับเหมือนกัน) `rejectedBy` ไม่มี — reject
  // ไม่นับเป็น "อนุมัติ" (mirror Config/Firmware ที่ reject ไม่ตั้ง approvedBy)
  approvedBy   String?
  approvedAt   DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  campaign Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creator  User                    @relation("CampaignRolloutCreatedBy", fields: [createdBy], references: [id])
  approver User?                   @relation("CampaignRolloutApprovedBy", fields: [approvedBy], references: [id])
  config   Config?                 @relation(fields: [configId], references: [id])
  firmware Firmware?               @relation(fields: [firmwareId], references: [id])
  targets  CampaignRolloutTarget[]
}

// ผลของ rollout หนึ่งรอบต่ออุปกรณ์หนึ่งเครื่อง (แก้ไข 2026-09-24, Campaign
// Monitor #22) — อัปเดตจาก `DeviceService.applyConfig`/`confirmFirmwareInstall`
// จริง (mock mode ก็รายงานผลได้ — ดู `MockConfigApplier`) ไม่ใช่ทฤษฎีอย่างเดียว
// deviceId ใช้ `Device.deviceId` เหมือน `CampaignTarget` ทุกประการ
enum CampaignRolloutTargetStatus {
  pending
  success
  failed
}

model CampaignRolloutTarget {
  id           String                      @id @default(uuid())
  rolloutId    String
  deviceId     String
  status       CampaignRolloutTargetStatus @default(pending)
  resultDetail String?
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt

  rollout CampaignRollout @relation(fields: [rolloutId], references: [id], onDelete: Cascade)

  @@unique([rolloutId, deviceId])
  @@index([rolloutId])
}

// ---------------------------------------------------------------------------
// Module: incident — ไม่มี schema ใน openapi.yaml เช่นกัน ออกแบบจาก RBAC
// Matrix: "Incident & Rollback" — ระบบสร้างอัตโนมัติ, Operation สั่ง
// Rollback (U), ST แก้ไขเชิงเทคนิค (U) เบี่ยงจาก Data Dictionary (INCIDENTS
// + DETECTION_RULES + INCIDENT_CORRELATIONS แยก 3 ตาราง มี state machine
// เต็มรูปแบบ DETECTED/TRIAGED/AWAITING_APPROVAL/MITIGATING/VERIFYING/
// RESOLVED/CLOSED/REOPENED, auto-rollback rule, correlation ที่ยังไม่ใช่
// MVP)
//
// เพิ่ม severity จาก Data Dictionary จริง (INCIDENTS.severity) — ตัดออก
// ไม่ได้เพราะ ST ต้องใช้จัดลำดับความสำคัญงานที่รับผิดชอบ ไม่งั้น incident
// ทุกอันจะดูสำคัญเท่ากันหมด — issue #25
// ---------------------------------------------------------------------------

enum IncidentSeverity {
  critical
  high
  medium
  low
}

enum IncidentStatus {
  open
  investigating
  rolled_back
  resolved
}

model Incident {
  id                String           @id @default(uuid())
  title             String
  description       String?
  severity          IncidentSeverity
  status            IncidentStatus   @default(open)
  relatedConfigId   String?
  relatedFirmwareId String?
  // ต้นทางที่สร้าง Incident (มติที่ประชุม #32 — docs/07 §9.5 Q2) — free string:
  //   'config-sync-writer'    = เขียน Config เข้า data กลางไม่สำเร็จ (ฝั่ง A)
  //   'mobile-simulator-test' = ช่างเทสต์ Simulator หน้างานไม่ผ่าน (ฝั่ง B, Phase 5)
  //   null                    = สร้างมือ / ยังไม่ระบุ
  // Incident มาจาก 2 ทางนี้ ต้อง shape เดียวกัน — ดู src/incident/incident-metadata.ts
  source            String?
  // รายละเอียดเชิงโครงสร้างเฉพาะ source นั้น (IncidentMetadata — ทุก key optional)
  // FK ที่ schema มีอยู่แล้ว (relatedConfigId/relatedFirmwareId) ไม่ต้องซ้ำที่นี่
  metadata          Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  relatedConfig   Config?   @relation(fields: [relatedConfigId], references: [id])
  relatedFirmware Firmware? @relation(fields: [relatedFirmwareId], references: [id])
}
